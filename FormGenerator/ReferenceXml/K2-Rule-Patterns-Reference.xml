  </Properties>
  <Parameters>
    <Parameter SourceType="Value" TargetID="{NOTES_ID}" TargetName="Notes" TargetDisplayName="Notes" TargetType="Control">
      <SourceValue xml:space="preserve"></SourceValue>
    </Parameter>
  </Parameters>
</Action>


<!-- ========================================================================
     PATTERN 12: CALCULATED FIELD - ARITHMETIC (A + B = Total)
     InfoPath: Calculated field with expression
     K2: Expression element + DataLabel control with ExpressionID

     CONTROL SETUP: Target must be Type="DataLabel" with ExpressionID attr
     and ControlExpression property pointing to the Expression ID.
     ======================================================================== -->

<!-- The target control definition (in <Controls> section): -->
<Control ID="{TOTAL_CONTROL_ID}" ExpressionID="{EXPRESSION_ID}" Type="DataLabel">
  <Properties>
    <Property><Name>ControlName</Name><DisplayValue>Total</DisplayValue><Value>Total</Value></Property>
    <Property><Name>DataType</Name><DisplayValue>Text</DisplayValue><Value>Text</Value></Property>
    <Property><Name>LiteralVal</Name><DisplayValue>false</DisplayValue><Value>false</Value></Property>
    <Property><Name>SanitizeHtml</Name><DisplayValue>false</DisplayValue><Value>false</Value></Property>
    <Property><Name>ControlExpression</Name>
      <DisplayValue>Number A + Number B Calculation</DisplayValue>
      <NameValue>Number A + Number B Calculation</NameValue>
      <Value>{EXPRESSION_ID}</Value>
    </Property>
  </Properties>
  <Name>Total</Name><DisplayName>Total</DisplayName>
</Control>

<!-- The expression definition (in <Expressions> section of View): -->
<Expression ID="{EXPRESSION_ID}">
  <Name>Number A + Number B Calculation</Name>
  <DisplayValue>Number A + Number B</DisplayValue>
  <Plus>
    <Item SourceType="Control"
          SourceID="{NUMBER_A_ID}"
          SourceName="Number A" SourceDisplayName="Number A"
          DisplayPath="{VIEW_NAME} - Controls - Number A"
          DataType="Text"/>
    <Item SourceType="Control"
          SourceID="{NUMBER_B_ID}"
          SourceName="Number B" SourceDisplayName="Number B"
          DisplayPath="{VIEW_NAME} - Controls - Number B"
          DataType="Text"/>
  </Plus>
</Expression>

<!-- Available operator elements: <Plus/>, <Minus/>, <Multiply/>, <Divide/> -->


<!-- ========================================================================
     PATTERN 13: CALCULATED FIELD - LIST SUM (Repeating section aggregate)
     InfoPath: sum(../my:item/my:amount) in calculated field
     K2: Expression with <ListSum> operator

     For FORM-LEVEL expressions (cross-view), Items need SourceInstanceID
     pointing to the view instance (Item element ID in form AreaItems).
     ======================================================================== -->

<!-- Expression at form level (in <Expressions> under <Form>): -->
<Expression ID="{EXPRESSION_ID}">
  <Name>Sum of all Amount fields</Name>
  <DisplayValue>List Sum( Amount TextBox )</DisplayValue>
  <ListSum>
    <Item SourceType="Control"
          SourceInstanceID="{VIEW_INSTANCE_ID}"
          SourceID="{AMOUNT_CONTROL_ID}"
          SourceName="Amount TextBox" SourceDisplayName="Amount TextBox"
          Type="TextBox"
          DisplayPath="{ITEM_VIEW_NAME} - Controls - Amount TextBox"
          DataType="Text">
      <Display>Amount TextBox</Display>
    </Item>
  </ListSum>
</Expression>


<!-- ========================================================================
     PATTERN 14: CALCULATED FIELD - SUBTRACT (A - B)
     InfoPath: my:subTotal - my:cashAdvance
     K2: Expression with <Minus> operator, SourceInstanceID for cross-view
     ======================================================================== -->
<Expression ID="{EXPRESSION_ID}">
  <Name>SubTotal - CashAdvance Calculation</Name>
  <DisplayValue>SubTotal TextBox - CashAdvance TextBox</DisplayValue>
  <Minus>
    <Item SourceType="Control"
          SourceInstanceID="{SUBTOTAL_VIEW_INSTANCE}"
          SourceID="{SUBTOTAL_CONTROL_ID}"
          SourceName="SubTotal TextBox" SourceDisplayName="SubTotal TextBox"
          Type="TextBox"
          DisplayPath="{VIEW_NAME} - Controls - SubTotal TextBox"
          DataType="Text">
      <Display>SubTotal TextBox</Display>
    </Item>
    <Item SourceType="Control"
          SourceInstanceID="{CASHADVANCE_VIEW_INSTANCE}"
          SourceID="{CASHADVANCE_CONTROL_ID}"
          SourceName="CashAdvance TextBox" SourceDisplayName="CashAdvance TextBox"
          Type="TextBox"
          DisplayPath="{VIEW_NAME} - Controls - CashAdvance TextBox"
          DataType="Text">
      <Display>CashAdvance TextBox</Display>
    </Item>
  </Minus>
</Expression>


<!-- ========================================================================
     PATTERN 15: CROSS-VIEW RULES (Form-level show/hide views)
     InfoPath: Conditional rules that affect controls on different views
     K2: Rules live at FORM level in States/State/Events

     KEY DIFFERENCES from view-level rules:
       - Handler Location = "form" (lowercase)
       - Condition/Action Location = "Form" (uppercase)
       - Event has InstanceID = source view's AreaItem ID
       - Action has InstanceID = target view's AreaItem ID
       - Condition Item has SourceInstanceID
     ======================================================================== -->

<!-- Form-level event structure (inside Form > States > State > Events): -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="User"
       SourceID="{SOURCE_CONTROL_ID}" SourceType="Control"
       SourceName="{SOURCE_NAME}" SourceDisplayName="{SOURCE_NAME}"
       InstanceID="{SOURCE_VIEW_AREA_ITEM_ID}">
  <Name>OnChange</Name>
  <Properties>
    <Property><Name>RuleFriendlyName</Name><Value>When {SOURCE_NAME} is Changed</Value></Property>
    <Property><Name>Location</Name><Value>{FORM_NAME}</Value></Property>
  </Properties>
  <Handlers>
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
        <Property><Name>Location</Name><Value>form</Value></Property>
      </Properties>
      <Conditions>
        <Condition ID="{GUID}" DefinitionID="{GUID}">
          <Properties>
            <Property><Name>Location</Name><Value>Form</Value></Property>
            <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
          </Properties>
          <Expressions>
            <Equals>
              <Item SourceType="Control"
                    SourceID="{SOURCE_CONTROL_ID}"
                    SourceInstanceID="{SOURCE_VIEW_AREA_ITEM_ID}"
                    SourceName="{SOURCE_NAME}" SourceDisplayName="{SOURCE_NAME}"
                    DataType="Text"/>
              <Item SourceType="Value" DataType="Text">Show</Item>
            </Equals>
          </Expressions>
        </Condition>
      </Conditions>
      <Actions>
        <!-- Show/hide an entire view -->
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous"
                InstanceID="{TARGET_VIEW_AREA_ITEM_ID}">
          <Properties>
            <Property><Name>Location</Name><Value>Form</Value></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value"
                       TargetID="display" TargetType="ViewProperty"
                       TargetInstanceID="{TARGET_VIEW_AREA_ITEM_ID}">
              <SourceValue xml:space="preserve">Show</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
        <!-- OR: Show/hide a control on a DIFFERENT view -->
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous"
                InstanceID="{TARGET_VIEW_AREA_ITEM_ID}">
          <Properties>
            <Property><Name>Location</Name><Value>Form</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>{TARGET_CONTROL_NAME}</DisplayValue><Value>{TARGET_CONTROL_ID}</Value></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value"
                       TargetID="isvisible" TargetDisplayName="{TARGET_CONTROL_NAME}" TargetType="ControlProperty"
                       TargetInstanceID="{TARGET_VIEW_AREA_ITEM_ID}">
              <SourceValue xml:space="preserve">true</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     PATTERN 16: GREATER THAN / LESS THAN CONDITIONS
     InfoPath: "If amount > 1000 then require approval"
     K2: GreaterThan / LessThan expression elements
     ======================================================================== -->
<Condition ID="{GUID}" DefinitionID="{GUID}">
  <Properties>
    <Property><Name>Location</Name><Value>View</Value></Property>
    <Property><Name>Name</Name><Value>SimpleGreaterThanControlCondition</Value></Property>
  </Properties>
  <Expressions>
    <GreaterThan>
      <Item SourceType="Control" SourceID="{AMOUNT_ID}"
            SourceName="Amount" SourceDisplayName="Amount" DataType="Text"/>
      <Item SourceType="Value" DataType="Text">1000</Item>
    </GreaterThan>
  </Expressions>
</Condition>

<!-- Less Than variant: -->
<Condition ID="{GUID}" DefinitionID="{GUID}">
  <Properties>
    <Property><Name>Location</Name><Value>View</Value></Property>
    <Property><Name>Name</Name><Value>SimpleLessThanControlCondition</Value></Property>
  </Properties>
  <Expressions>
    <LessThan>
      <Item SourceType="Control" SourceID="{AMOUNT_ID}"
            SourceName="Amount" SourceDisplayName="Amount" DataType="Text"/>
      <Item SourceType="Value" DataType="Text">0</Item>
    </LessThan>
  </Expressions>
</Condition>


<!-- ========================================================================
     PATTERN 17: CONTAINS CONDITION
     InfoPath: contains(field, "text") in condition
     K2: Contains expression element
     ======================================================================== -->
<Condition ID="{GUID}" DefinitionID="{GUID}">
  <Properties>
    <Property><Name>Location</Name><Value>View</Value></Property>
    <Property><Name>Name</Name><Value>SimpleContainsControlCondition</Value></Property>
  </Properties>
  <Expressions>
    <Contains>
      <Item SourceType="Control" SourceID="{CONTROL_ID}"
            SourceName="{CONTROL_NAME}" SourceDisplayName="{CONTROL_NAME}" DataType="Text"/>
      <Item SourceType="Value" DataType="Text">searchterm</Item>
    </Contains>
  </Expressions>
</Condition>


<!-- ========================================================================
     PATTERN 18: MULTI-ACTION RULE (Show field + Set value in one handler)
     InfoPath: Rule with multiple actions
     K2: Multiple Action elements inside same Handler
     ======================================================================== -->
<Handler ID="{GUID}" DefinitionID="{GUID}">
  <Properties>
    <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
    <Property><Name>Location</Name><Value>view</Value></Property>
  </Properties>
  <Conditions>
    <Condition ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>Location</Name><Value>View</Value></Property>
        <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
      </Properties>
      <Expressions>
        <Equals>
          <Item SourceType="Control" SourceID="{STATUS_ID}"
                SourceName="Status" SourceDisplayName="Status" DataType="Text"/>
          <Item SourceType="Value" DataType="Text">Approved</Item>
        </Equals>
      </Expressions>
    </Condition>
  </Conditions>
  <Actions>
    <!-- Action 1: Show the approval section -->
    <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
      <Properties>
        <Property><Name>Location</Name><Value>View</Value></Property>
        <Property><Name>ControlID</Name><DisplayValue>ApprovalSection</DisplayValue><NameValue>ApprovalSection</NameValue><Value>{SECTION_ID}</Value></Property>
        <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
      </Properties>
      <Parameters>
        <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="ApprovalSection" TargetType="ControlProperty">
          <SourceValue xml:space="preserve">true</SourceValue>
        </Parameter>
      </Parameters>
    </Action>
    <!-- Action 2: Set the approved date to today -->
    <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
      <Properties>
        <Property><Name>Location</Name><Value>View</Value></Property>
        <Property><Name>ControlID</Name><DisplayValue>ApprovedDate</DisplayValue><NameValue>ApprovedDate</NameValue><Value>{DATE_ID}</Value></Property>
        <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
      </Properties>
      <Parameters>
        <Parameter SourceType="Value" TargetID="{DATE_ID}" TargetName="ApprovedDate" TargetDisplayName="ApprovedDate" TargetType="Control">
          <SourceValue xml:space="preserve">today</SourceValue>
        </Parameter>
      </Parameters>
    </Action>
    <!-- Action 3: Disable the amount field -->
    <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
      <Properties>
        <Property><Name>Location</Name><Value>View</Value></Property>
        <Property><Name>ControlID</Name><DisplayValue>Amount</DisplayValue><NameValue>Amount</NameValue><Value>{AMOUNT_ID}</Value></Property>
        <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
      </Properties>
      <Parameters>
        <Parameter SourceType="Value" TargetID="IsReadOnly" TargetDisplayName="Amount" TargetType="ControlProperty">
          <SourceValue xml:space="preserve">true</SourceValue>
        </Parameter>
      </Parameters>
    </Action>
  </Actions>
</Handler>


<!-- ========================================================================
     PATTERN 19: SYSTEM EVENTS (Auto-generated, always present per control)
     These are created by K2 automatically. Custom User events are added
     alongside these. DO NOT duplicate system events.
     ======================================================================== -->

<!-- View Init (always present): -->
<Event ID="{GUID}" DefinitionID="{GUID}" Type="System"
       SourceID="{VIEW_ID}" SourceType="View"
       SourceName="{VIEW_NAME}" SourceDisplayName="{VIEW_NAME}">
  <Name>Init</Name>
  <Handlers>
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Calculate" ExecutionType="Synchronous"/>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="ApplyStyle" ExecutionType="Synchronous"/>
      </Actions>
    </Handler>
  </Handlers>
</Event>

<!-- Control OnChange (one per data control): -->
<Event ID="{GUID}" DefinitionID="{GUID}" Type="System"
       SourceID="{CONTROL_ID}" SourceType="Control"
       SourceName="{CONTROL_NAME}" SourceDisplayName="{CONTROL_NAME}">
  <Name>OnChange</Name>
  <Handlers>
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Calculate" ExecutionType="Synchronous"/>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="ApplyStyle" ExecutionType="Synchronous"/>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Validate" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>ViewID</Name><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue><Value>{VIEW_ID}</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>{CONTROL_NAME}</DisplayValue><NameValue>{CONTROL_NAME}</NameValue><Value>{CONTROL_ID}</Value></Property>
          </Properties>
        </Action>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     SUMMARY: InfoPath Rule Type → K2 Pattern Mapping
     ========================================================================

     InfoPath Rule                    K2 Pattern              Reference
     ─────────────────────────────    ────────────────────    ─────────
     Validation (required)            Pattern 1               ShowMessage + IsBlank
     Conditional visibility           Patterns 2, 3           Transfer isvisible
     Set field value                  Patterns 10, 11         Transfer to Control
     Copy field to field              Pattern 4               Control-to-Control
     Default values                   Pattern 5               Init event Transfer
     AND conditions                   Pattern 6               Multiple Conditions
     OR conditions                    Pattern 7               Multiple Handlers
     Calculated field (arithmetic)    Pattern 12              Expression + DataLabel
     Calculated field (aggregate)     Pattern 13              ListSum Expression
     Enable/disable field             Pattern 9               Transfer IsReadOnly
     Cross-view rules                 Pattern 15              Form-level Events
     Comparison (>, <)                Pattern 16              GreaterThan/LessThan
     Text contains                    Pattern 17              Contains
     Multiple actions                 Pattern 18              Multi-Action Handler

     CONDITION EXPRESSION ELEMENTS:
       <Equals>        = Equal to
       <NotEquals>     = Not equal to
       <GreaterThan>   = Greater than
       <LessThan>      = Less than
       <Contains>      = Contains text
       <IsBlank>       = Field is empty (single Item, no comparison value)
       <StartsWith>    = Starts with text
       <EndsWith>      = Ends with text

     EXPRESSION OPERATOR ELEMENTS (for calculations):
       <Plus>          = Addition
       <Minus>         = Subtraction
       <Multiply>      = Multiplication
       <Divide>        = Division
       <ListSum>       = Sum of repeating field values
       <ListCount>     = Count of repeating field values
       <ListAverage>   = Average of repeating field values

     ======================================================================== -->
