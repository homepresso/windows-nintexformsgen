<!--
  ============================================================================
  K2 SMARTFORMS RULE PATTERNS REFERENCE
  ============================================================================

  This file contains verified K2 SmartForms XML patterns for all common rule
  types that arise from InfoPath form conversions. Each pattern was extracted
  from working K2 Designer exports and validated against the K2 runtime.

  PLACEHOLDER CONVENTION:
    {GUID}           = Guid.NewGuid().ToString()
    {VIEW_ID}        = The View element's ID attribute
    {VIEW_NAME}      = The View element's Name (e.g., "MyFormView")
    {CONTROL_ID}     = Target control's ID attribute
    {CONTROL_NAME}   = Target control's display name (e.g., "Status")
    {SOURCE_ID}      = Source control's ID attribute
    {SOURCE_NAME}    = Source control's display name
    {VIEW_INSTANCE}  = The Item element's ID in form-level AreaItems

  KEY RULES:
    - Handler Location = "view" (lowercase)
    - Condition/Action Location = "View" (uppercase)
    - Event Location = view name (e.g., "MyFormView")
    - If/Else both use IfLogicalHandler (NO ElseLogicalHandler)
    - ExecutionType = "Synchronous" for visibility/transfer rules
    - SourceValue is a CHILD ELEMENT, not an attribute
    - System events (Init, OnChange) are auto-generated by K2
    - User events contain the custom rule logic
  ============================================================================
-->

<!-- ========================================================================
     PATTERN 1: REQUIRED FIELD VALIDATION (ShowMessage when blank)
     InfoPath: Validation rule "field cannot be blank"
     K2: ShowMessage action with SimpleBlankControlCondition
     ======================================================================== -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="User"
       SourceID="{CONTROL_ID}" SourceType="Control"
       SourceName="{CONTROL_NAME}" SourceDisplayName="{CONTROL_NAME}"
       IsExtended="True">
  <Name>OnChange</Name>
  <Properties>
    <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
    <Property><Name>RuleFriendlyName</Name><Value>When {CONTROL_NAME} is Changed</Value></Property>
    <Property><Name>Location</Name><Value>{VIEW_NAME}</Value></Property>
  </Properties>
  <Handlers>
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
        <Property><Name>Location</Name><Value>view</Value></Property>
      </Properties>
      <!-- Condition: field is blank -->
      <Conditions>
        <Condition ID="{GUID}" DefinitionID="{GUID}">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>Name</Name><Value>SimpleBlankControlCondition</Value></Property>
          </Properties>
          <Expressions>
            <IsBlank>
              <Item SourceType="Control"
                    SourceID="{CONTROL_ID}"
                    SourceName="{CONTROL_NAME}"
                    SourceDisplayName="{CONTROL_NAME}"
                    DataType="Text"/>
            </IsBlank>
          </Expressions>
        </Condition>
      </Conditions>
      <!-- Action: show validation message -->
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}"
                Type="ShowMessage" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value" TargetType="Message">
              <SourceValue xml:space="preserve"><Source SourceType="Value">{CONTROL_NAME} is required.</Source></SourceValue>
            </Parameter>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     PATTERN 2: CHECKBOX TOGGLE VISIBILITY (If true show / If false hide)
     InfoPath: Conditional formatting "hide control when checkbox unchecked"
     K2: Two IfLogicalHandler blocks (true=show, false=hide)
     NOTE: Both handlers use IfLogicalHandler. There is NO ElseLogicalHandler.
     ======================================================================== -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="User"
       SourceID="{CHECKBOX_ID}" SourceType="Control"
       SourceName="ShowDetails" SourceDisplayName="ShowDetails">
  <Name>OnChange</Name>
  <Properties>
    <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
    <Property><Name>RuleFriendlyName</Name><Value>When ShowDetails is Changed</Value></Property>
    <Property><Name>Location</Name><Value>{VIEW_NAME}</Value></Property>
  </Properties>
  <Handlers>
    <!-- IF checkbox = true THEN show -->
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
        <Property><Name>Location</Name><Value>view</Value></Property>
      </Properties>
      <Conditions>
        <Condition ID="{GUID}" DefinitionID="{GUID}">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
          </Properties>
          <Expressions>
            <Equals>
              <Item SourceType="Control" SourceID="{CHECKBOX_ID}"
                    SourceName="ShowDetails" SourceDisplayName="ShowDetails" DataType="Text"/>
              <Item SourceType="Value" DataType="Text">true</Item>
            </Equals>
          </Expressions>
        </Condition>
      </Conditions>
      <Actions>
        <!-- Show Detail1 -->
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>Detail1</DisplayValue><NameValue>Detail1</NameValue><Value>{DETAIL1_ID}</Value></Property>
            <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="Detail1" TargetType="ControlProperty">
              <SourceValue xml:space="preserve">true</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
        <!-- Show Detail2 -->
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>Detail2</DisplayValue><NameValue>Detail2</NameValue><Value>{DETAIL2_ID}</Value></Property>
            <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="Detail2" TargetType="ControlProperty">
              <SourceValue xml:space="preserve">true</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
    <!-- IF checkbox = false THEN hide (this is the "else" — also IfLogicalHandler) -->
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
        <Property><Name>Location</Name><Value>view</Value></Property>
      </Properties>
      <Conditions>
        <Condition ID="{GUID}" DefinitionID="{GUID}">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
          </Properties>
          <Expressions>
            <Equals>
              <Item SourceType="Control" SourceID="{CHECKBOX_ID}"
                    SourceName="ShowDetails" SourceDisplayName="ShowDetails" DataType="Text"/>
              <Item SourceType="Value" DataType="Text">false</Item>
            </Equals>
          </Expressions>
        </Condition>
      </Conditions>
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>Detail1</DisplayValue><NameValue>Detail1</NameValue><Value>{DETAIL1_ID}</Value></Property>
            <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="Detail1" TargetType="ControlProperty">
              <SourceValue xml:space="preserve">false</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>Detail2</DisplayValue><NameValue>Detail2</NameValue><Value>{DETAIL2_ID}</Value></Property>
            <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="Detail2" TargetType="ControlProperty">
              <SourceValue xml:space="preserve">false</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     PATTERN 3: DROPDOWN VALUE-BASED VISIBILITY
     InfoPath: "Show section when Category = Entertainment"
     K2: OnChange event on dropdown, if equals value then show controls
     ======================================================================== -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="User"
       SourceID="{DROPDOWN_ID}" SourceType="Control"
       SourceName="Category" SourceDisplayName="Category"
       IsExtended="True">
  <Name>OnChange</Name>
  <Properties>
    <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
    <Property><Name>RuleFriendlyName</Name><Value>When Category is Changed</Value></Property>
    <Property><Name>Location</Name><Value>{VIEW_NAME}</Value></Property>
  </Properties>
  <Handlers>
    <!-- IF Category = "Entertainment" THEN show entertainment fields -->
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
        <Property><Name>Location</Name><Value>view</Value></Property>
      </Properties>
      <Conditions>
        <Condition ID="{GUID}" DefinitionID="{GUID}">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
          </Properties>
          <Expressions>
            <Equals>
              <Item SourceType="Control" SourceID="{DROPDOWN_ID}"
                    SourceName="Category" SourceDisplayName="Category" DataType="Text"/>
              <Item SourceType="Value" DataType="Text">Entertainment</Item>
            </Equals>
          </Expressions>
        </Condition>
      </Conditions>
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>EntertainmentDetails</DisplayValue><NameValue>EntertainmentDetails</NameValue><Value>{TARGET_CONTROL_ID}</Value></Property>
            <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="EntertainmentDetails" TargetType="ControlProperty">
              <SourceValue xml:space="preserve">true</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
    <!-- IF Category != "Entertainment" THEN hide (use NotEquals) -->
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
        <Property><Name>Location</Name><Value>view</Value></Property>
      </Properties>
      <Conditions>
        <Condition ID="{GUID}" DefinitionID="{GUID}">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>Name</Name><Value>SimpleNotEqualControlCondition</Value></Property>
          </Properties>
          <Expressions>
            <NotEquals>
              <Item SourceType="Control" SourceID="{DROPDOWN_ID}"
                    SourceName="Category" SourceDisplayName="Category" DataType="Text"/>
              <Item SourceType="Value" DataType="Text">Entertainment</Item>
            </NotEquals>
          </Expressions>
        </Condition>
      </Conditions>
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>EntertainmentDetails</DisplayValue><NameValue>EntertainmentDetails</NameValue><Value>{TARGET_CONTROL_ID}</Value></Property>
            <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="EntertainmentDetails" TargetType="ControlProperty">
              <SourceValue xml:space="preserve">false</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     PATTERN 4: CONTROL-TO-CONTROL DATA TRANSFER
     InfoPath: "Set field B = field A" action rule
     K2: Transfer action with SourceType="Control" and TargetType="Control"
     NOTE: No SourceValue child element for control-to-control transfers.
     ======================================================================== -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="User"
       SourceID="{SOURCE_ID}" SourceType="Control"
       SourceName="SourceField" SourceDisplayName="SourceField"
       IsExtended="True">
  <Name>OnChange</Name>
  <Properties>
    <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
    <Property><Name>RuleFriendlyName</Name><Value>When SourceField is Changed</Value></Property>
    <Property><Name>Location</Name><Value>{VIEW_NAME}</Value></Property>
  </Properties>
  <Handlers>
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
        <Property><Name>Location</Name><Value>view</Value></Property>
      </Properties>
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
          </Properties>
          <Parameters>
            <!-- No SourceValue element — source and target are both controls -->
            <Parameter SourceID="{SOURCE_ID}" SourceName="SourceField" SourceDisplayName="SourceField" SourceType="Control"
                       TargetID="{TARGET_ID}" TargetName="TargetField" TargetDisplayName="TargetField" TargetType="Control"/>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     PATTERN 5: SET DEFAULT VALUE ON INIT
     InfoPath: Default value on form load (e.g., today's date, user name)
     K2: Transfer action in View Init event setting a literal value
     ======================================================================== -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="User"
       SourceID="{VIEW_ID}" SourceType="View"
       SourceName="{VIEW_NAME}" SourceDisplayName="{VIEW_NAME}">
  <Name>Init</Name>
  <Properties>
    <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
    <Property><Name>RuleFriendlyName</Name><Value>When {VIEW_NAME} Initializes</Value></Property>
    <Property><Name>Location</Name><Value>{VIEW_NAME}</Value></Property>
  </Properties>
  <Handlers>
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
        <Property><Name>Location</Name><Value>view</Value></Property>
      </Properties>
      <Actions>
        <!-- Set Status dropdown to "Draft" -->
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>Status</DisplayValue><NameValue>Status</NameValue><Value>{STATUS_CONTROL_ID}</Value></Property>
            <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
          </Properties>
          <Parameters>
            <Parameter SourceType="Value" TargetID="{STATUS_CONTROL_ID}" TargetName="Status" TargetDisplayName="Status" TargetType="Control">
              <SourceValue xml:space="preserve">Draft</SourceValue>
            </Parameter>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     PATTERN 6: AND CONDITION (Multiple conditions = AND logic)
     InfoPath: "If Status=Active AND Priority=High then show notes"
     K2: Multiple <Condition> elements inside <Conditions> = implicit AND
     NOTE: No Composite wrapper needed. Just multiple Condition elements.
     ======================================================================== -->
<Handler ID="{GUID}" DefinitionID="{GUID}">
  <Properties>
    <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
    <Property><Name>Location</Name><Value>view</Value></Property>
  </Properties>
  <Conditions>
    <!-- Condition 1: Status = Active -->
    <Condition ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>Location</Name><Value>View</Value></Property>
        <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
      </Properties>
      <Expressions>
        <Equals>
          <Item SourceType="Control" SourceID="{STATUS_ID}"
                SourceName="Status" SourceDisplayName="Status" DataType="Text"/>
          <Item SourceType="Value" DataType="Text">Active</Item>
        </Equals>
      </Expressions>
    </Condition>
    <!-- Condition 2: Priority = High (AND with Condition 1) -->
    <Condition ID="{GUID}" DefinitionID="{GUID}">
      <Properties>
        <Property><Name>Location</Name><Value>View</Value></Property>
        <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
      </Properties>
      <Expressions>
        <Equals>
          <Item SourceType="Control" SourceID="{PRIORITY_ID}"
                SourceName="Priority" SourceDisplayName="Priority" DataType="Text"/>
          <Item SourceType="Value" DataType="Text">High</Item>
        </Equals>
      </Expressions>
    </Condition>
  </Conditions>
  <Actions>
    <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
      <Properties>
        <Property><Name>Location</Name><Value>View</Value></Property>
        <Property><Name>ControlID</Name><DisplayValue>Notes</DisplayValue><NameValue>Notes</NameValue><Value>{NOTES_ID}</Value></Property>
        <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
      </Properties>
      <Parameters>
        <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="Notes" TargetType="ControlProperty">
          <SourceValue xml:space="preserve">true</SourceValue>
        </Parameter>
      </Parameters>
    </Action>
  </Actions>
</Handler>


<!-- ========================================================================
     PATTERN 7: OR CONDITION (Multiple handlers = OR logic)
     InfoPath: "If Status=Urgent OR Priority=High then show warning"
     K2: OR is achieved by having SEPARATE handlers in the same event.
     Each handler fires independently - if ANY matches, its actions run.
     ======================================================================== -->
<Handlers>
  <!-- Handler 1: IF Status = Urgent -->
  <Handler ID="{GUID}" DefinitionID="{GUID}">
    <Properties>
      <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
      <Property><Name>Location</Name><Value>view</Value></Property>
    </Properties>
    <Conditions>
      <Condition ID="{GUID}" DefinitionID="{GUID}">
        <Properties>
          <Property><Name>Location</Name><Value>View</Value></Property>
          <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
        </Properties>
        <Expressions>
          <Equals>
            <Item SourceType="Control" SourceID="{STATUS_ID}"
                  SourceName="Status" SourceDisplayName="Status" DataType="Text"/>
            <Item SourceType="Value" DataType="Text">Urgent</Item>
          </Equals>
        </Expressions>
      </Condition>
    </Conditions>
    <Actions>
      <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
        <Properties>
          <Property><Name>Location</Name><Value>View</Value></Property>
          <Property><Name>ControlID</Name><DisplayValue>WarningLabel</DisplayValue><NameValue>WarningLabel</NameValue><Value>{WARNING_ID}</Value></Property>
          <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
        </Properties>
        <Parameters>
          <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="WarningLabel" TargetType="ControlProperty">
            <SourceValue xml:space="preserve">true</SourceValue>
          </Parameter>
        </Parameters>
      </Action>
    </Actions>
  </Handler>
  <!-- Handler 2: IF Priority = High (OR — separate handler) -->
  <Handler ID="{GUID}" DefinitionID="{GUID}">
    <Properties>
      <Property><Name>HandlerName</Name><Value>IfLogicalHandler</Value></Property>
      <Property><Name>Location</Name><Value>view</Value></Property>
    </Properties>
    <Conditions>
      <Condition ID="{GUID}" DefinitionID="{GUID}">
        <Properties>
          <Property><Name>Location</Name><Value>View</Value></Property>
          <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
        </Properties>
        <Expressions>
          <Equals>
            <Item SourceType="Control" SourceID="{PRIORITY_ID}"
                  SourceName="Priority" SourceDisplayName="Priority" DataType="Text"/>
            <Item SourceType="Value" DataType="Text">High</Item>
          </Equals>
        </Expressions>
      </Condition>
    </Conditions>
    <Actions>
      <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
        <Properties>
          <Property><Name>Location</Name><Value>View</Value></Property>
          <Property><Name>ControlID</Name><DisplayValue>WarningLabel</DisplayValue><NameValue>WarningLabel</NameValue><Value>{WARNING_ID}</Value></Property>
          <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
        </Properties>
        <Parameters>
          <Parameter SourceType="Value" TargetID="isvisible" TargetDisplayName="WarningLabel" TargetType="ControlProperty">
            <SourceValue xml:space="preserve">true</SourceValue>
          </Parameter>
        </Parameters>
      </Action>
    </Actions>
  </Handler>
</Handlers>


<!-- ========================================================================
     PATTERN 8: NOT EQUAL CONDITION
     InfoPath: "If field != empty then enable submit"
     K2: NotEquals expression element
     ======================================================================== -->
<Condition ID="{GUID}" DefinitionID="{GUID}">
  <Properties>
    <Property><Name>Location</Name><Value>View</Value></Property>
    <Property><Name>Name</Name><Value>SimpleNotEqualControlCondition</Value></Property>
  </Properties>
  <Expressions>
    <NotEquals>
      <Item SourceType="Control" SourceID="{CONTROL_ID}"
            SourceName="{CONTROL_NAME}" SourceDisplayName="{CONTROL_NAME}" DataType="Text"/>
      <Item SourceType="Value" DataType="Text"></Item>
    </NotEquals>
  </Expressions>
</Condition>


<!-- ========================================================================
     PATTERN 9: ENABLE/DISABLE CONTROL (Toggle ReadOnly)
     InfoPath: "Disable field when status is Approved"
     K2: Transfer to ControlProperty "IsReadOnly" = true/false
     ======================================================================== -->
<Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
  <Properties>
    <Property><Name>Location</Name><Value>View</Value></Property>
    <Property><Name>ControlID</Name><DisplayValue>Amount</DisplayValue><NameValue>Amount</NameValue><Value>{AMOUNT_ID}</Value></Property>
    <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue></Property>
  </Properties>
  <Parameters>
    <Parameter SourceType="Value" TargetID="IsReadOnly" TargetDisplayName="Amount" TargetType="ControlProperty">
      <SourceValue xml:space="preserve">true</SourceValue>
    </Parameter>
  </Parameters>
</Action>


<!-- ========================================================================
     PATTERN 10: SET CONTROL VALUE (Transfer literal value to control)
     InfoPath: "Set field = specific value" action
     K2: Transfer with SourceType="Value", TargetType="Control"
     ======================================================================== -->
<Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
