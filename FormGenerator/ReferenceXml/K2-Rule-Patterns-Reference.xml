      <SourceValue xml:space="preserve">Submitted</SourceValue>
    </Parameter>
  </Parameters>
</Action>


<!-- ========================================================================
     PATTERN 11: CLEAR FIELD VALUE (Set to empty)
     InfoPath: "Set field = blank" action
     K2: Transfer with empty SourceValue
