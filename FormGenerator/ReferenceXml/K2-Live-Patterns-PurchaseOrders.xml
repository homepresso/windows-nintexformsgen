<!-- ========================================================================
     PATTERN: VIEW-LEVEL INIT EVENT (System + User pair)
     K2 creates a System Init event automatically, then User Init for custom rules
     ======================================================================== -->

<!-- System Init Event (auto-generated, contains default Calculate/ApplyStyle) -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="System"
       SourceID="{VIEW_ID}" SourceType="View"
       SourceName="{VIEW_NAME}" SourceDisplayName="{VIEW_NAME}">
  <Name>Init</Name>
  <Handlers>
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Calculate" ExecutionType="Synchronous"/>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="ApplyStyle" ExecutionType="Synchronous"/>
      </Actions>
    </Handler>
  </Handlers>
</Event>

<!-- User Init Event (custom rules triggered on view initialize) -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="User"
       SourceID="{VIEW_ID}" SourceType="View"
       SourceName="Init" SourceDisplayName="Initializing">
  <Name>Init</Name>
  <Properties>
    <Property><Name>RuleFriendlyName</Name><Value>When the view executed Initialize</Value></Property>
    <Property><Name>Location</Name><Value>{VIEW_NAME}</Value></Property>
    <Property><Name>ViewID</Name><Value>{VIEW_ID}</Value></Property>
  </Properties>
  <Handlers>
    <!-- Handler WITHOUT conditions (always executes) -->
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>ViewID</Name><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue><Value>{VIEW_ID}</Value></Property>
          </Properties>
          <Parameters>
            <Parameter SourceID="{SOURCE_CONTROL_ID}" SourceType="Control" SourceName="{SOURCE_CONTROL_NAME}" SourceDisplayName="{SOURCE_CONTROL_NAME}" TargetID="{TARGET_FIELD_ID}" TargetType="ViewField"/>
          </Parameters>
        </Action>
      </Actions>
    </Handler>
    <!-- Handler WITH conditions (conditional execution) -->
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Conditions>
        <Condition ID="{GUID}" DefinitionID="{GUID}">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>Name</Name><Value>SimpleNotBlankViewParameterCondition</Value></Property>
          </Properties>
          <Expressions>
            <IsNotBlank>
              <Item SourceType="ViewParameter" SourceID="{PARAM_NAME}" SourceName="{PARAM_NAME}" DataType="Text"/>
            </IsNotBlank>
          </Expressions>
        </Condition>
      </Conditions>
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Execute" ExecutionType="Synchronous">
          <Properties>
            <Property><Name>Location</Name><Value>View</Value></Property>
            <Property><Name>ControlID</Name><DisplayValue>{CONTROL_NAME}</DisplayValue><NameValue>{CONTROL_NAME}</NameValue><Value>{CONTROL_ID}</Value></Property>
            <Property><Name>Method</Name><DisplayValue>{METHOD_NAME}</DisplayValue><NameValue>{METHOD_NAME}</NameValue><Value>{METHOD_NAME}</Value></Property>
            <Property><Name>ViewID</Name><NameValue>{VIEW_NAME}</NameValue><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue></Property>
            <Property><Name>ObjectID</Name><DisplayValue>{SMARTOBJECT_NAME}</DisplayValue><NameValue>{SMARTOBJECT_SYSTEM_NAME}</NameValue><Value>{SMARTOBJECT_GUID}</Value></Property>
          </Properties>
          <Parameters>
            <Parameter SourceID="{PARAM_SOURCE_ID}" SourceType="ViewParameter" SourceName="{PARAM_NAME}" SourceDisplayName="{PARAM_NAME}" TargetID="{METHOD_PARAM_ID}" TargetType="MethodParameter" TargetName="{METHOD_PARAM_NAME}" TargetDisplayName="{METHOD_PARAM_NAME}" TargetPath="{METHOD_PARAM_NAME}"/>
          </Parameters>
          <Results>
            <Result SourceID="{RESULT_FIELD_ID}" SourceType="MethodResult" SourceName="{RESULT_FIELD_NAME}" SourceDisplayName="{RESULT_FIELD_NAME}" TargetID="{TARGET_CONTROL_ID}" TargetType="ControlProperty" TargetName="{TARGET_CONTROL_NAME}" TargetDisplayName="{TARGET_CONTROL_NAME}"/>
          </Results>
        </Action>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     PATTERN: SYSTEM ONCHANGE EVENT (auto-generated for each control)
     K2 creates these automatically for every control on the view
     ======================================================================== -->
<Event ID="{GUID}" DefinitionID="{GUID}"
       Type="System"
       SourceID="{CONTROL_ID}" SourceType="Control"
       SourceName="{CONTROL_NAME}" SourceDisplayName="{CONTROL_NAME}">
  <Name>OnChange</Name>
  <Handlers>
    <Handler ID="{GUID}" DefinitionID="{GUID}">
      <Actions>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="Calculate" ExecutionType="Synchronous"/>
        <Action ID="{GUID}" DefinitionID="{GUID}" Type="ApplyStyle" ExecutionType="Synchronous"/>
      </Actions>
    </Handler>
  </Handlers>
</Event>


<!-- ========================================================================
     PATTERN: TRANSFER ACTION (Control-to-ViewField data binding)
     Maps control values to view fields for persistence
     ======================================================================== -->
<Action ID="{GUID}" DefinitionID="{GUID}" Type="Transfer" ExecutionType="Synchronous">
  <Properties>
    <Property><Name>ViewID</Name><DisplayValue>{VIEW_NAME}</DisplayValue><NameValue>{VIEW_NAME}</NameValue><Value>{VIEW_ID}</Value></Property>
  </Properties>
  <Parameters>
    <!-- Multiple Parameter elements for multi-field transfer -->
    <Parameter SourceID="{CONTROL_ID_1}" SourceType="Control" SourceName="{CONTROL_NAME_1}" SourceDisplayName="{CONTROL_NAME_1}" TargetID="{FIELD_ID_1}" TargetType="ViewField"/>
    <Parameter SourceID="{CONTROL_ID_2}" SourceType="Control" SourceName="{CONTROL_NAME_2}" SourceDisplayName="{CONTROL_NAME_2}" TargetID="{FIELD_ID_2}" TargetType="ViewField"/>
  </Parameters>
</Action>


<!-- ========================================================================
     PATTERN: EXECUTE ACTION (SmartObject method call)
     Calls a SmartObject method with parameters and maps results
     ======================================================================== -->
<Action ID="{GUID}" DefinitionID="{GUID}" Type="Execute" ExecutionType="Synchronous" IsEnabled="True">
  <Properties>
    <Property><Name>Location</Name><Value>View</Value></Property>
    <Property><Name>ControlID</Name><DisplayValue>{CONTROL_NAME}</DisplayValue><NameValue>{CONTROL_NAME}</NameValue><Value>{CONTROL_ID}</Value></Property>
    <Property><Name>Method</Name><DisplayValue>GetList</DisplayValue><NameValue>GetList</NameValue><Value>GetList</Value></Property>
    <Property><Name>ViewID</Name><NameValue>{VIEW_NAME}</NameValue><Value>{VIEW_ID}</Value><DisplayValue>{VIEW_NAME}</DisplayValue></Property>
    <Property><Name>ObjectID</Name><DisplayValue>{SMARTOBJECT_DISPLAY_NAME}</DisplayValue><NameValue>{SMARTOBJECT_SYSTEM_NAME}</NameValue><Value>{SMARTOBJECT_GUID}</Value></Property>
  </Properties>
  <Parameters>
    <Parameter SourceID="{SOURCE_ID}" SourceType="ViewParameter" SourceName="{PARAM_NAME}" SourceDisplayName="{PARAM_NAME}" TargetID="{METHOD_PARAM_ID}" TargetType="MethodParameter" TargetName="{METHOD_PARAM_NAME}" TargetDisplayName="{METHOD_PARAM_NAME}" TargetPath="{METHOD_PARAM_NAME}"/>
  </Parameters>
  <Results>
    <Result SourceID="{RESULT_FIELD_ID}" SourceType="MethodResult" SourceName="{FIELD_NAME}" SourceDisplayName="{FIELD_NAME}" TargetID="{CONTROL_ID}" TargetType="ControlProperty" TargetName="{CONTROL_NAME}" TargetDisplayName="{CONTROL_NAME}"/>
  </Results>
</Action>


<!-- ========================================================================
     PATTERN: CONDITION WITH ISNOTBLANK EXPRESSION
     Checks if a ViewParameter or Control value is not blank
     ======================================================================== -->
<Conditions>
  <Condition ID="{GUID}" DefinitionID="{GUID}">
    <Properties>
      <Property><Name>Location</Name><Value>View</Value></Property>
      <Property><Name>Name</Name><Value>SimpleNotBlankViewParameterCondition</Value></Property>
    </Properties>
    <Expressions>
      <IsNotBlank>
        <Item SourceType="ViewParameter" SourceID="{PARAM_NAME}" SourceName="{PARAM_NAME}" DataType="Text"/>
      </IsNotBlank>
    </Expressions>
  </Condition>
</Conditions>

<!-- Condition with Equals expression (control value check) -->
<Conditions>
  <Condition ID="{GUID}" DefinitionID="{GUID}">
    <Properties>
      <Property><Name>Location</Name><Value>View</Value></Property>
      <Property><Name>Name</Name><Value>SimpleEqualControlCondition</Value></Property>
    </Properties>
    <Expressions>
      <Equals>
        <Item SourceType="Control" SourceID="{CONTROL_ID}" SourceName="{CONTROL_NAME}" SourceDisplayName="{CONTROL_NAME}" DataType="Text"/>
        <Item SourceType="Value"><Value>true</Value></Item>
      </Equals>
    </Expressions>
  </Condition>
</Conditions>


<!-- ========================================================================
     PATTERN: CALCULATION EXPRESSIONS (View-level, not inside Events)
     These are defined at the View level, referenced by Calculate actions
     ======================================================================== -->

<!-- Sum Expression: Aggregates a field across rows (non-list) -->
<Expression ID="{GUID}">
  <Name>GrandTotal</Name>
  <DisplayValue>Sum( Total )</DisplayValue>
  <Sum>
    <Item SourceType="ViewField" SourceID="{FIELD_ID}" SourceName="Total" SourceDisplayName="Total" DataType="Text"/>
  </Sum>
</Expression>

<!-- Multiply Expression: Row-level calculation (Quantity * UnitCost) -->
<Expression ID="{GUID}">
  <Name>ItemTotal</Name>
  <DisplayValue>Quantity Text Box * Unit Cost Text Box</DisplayValue>
  <Multiply>
    <Item SourceType="Control" SourceID="{QUANTITY_CONTROL_ID}" SourceName="Quantity Text Box" SourceDisplayName="Quantity Text Box" DataType="Number"/>
    <Item SourceType="Control" SourceID="{UNITCOST_CONTROL_ID}" SourceName="Unit Cost Text Box" SourceDisplayName="Unit Cost Text Box" DataType="Number"/>
  </Multiply>
</Expression>

<!-- ListSum Expression: Aggregate across list rows -->
<Expression ID="{GUID}">
  <Name>Sum</Name>
  <DisplayValue>List Sum( Total )</DisplayValue>
  <ListSum>
    <Item SourceType="ViewField" SourceID="{FIELD_ID}" SourceName="Total" SourceDisplayName="Total" DataType="Text"/>
  </ListSum>
</Expression>


